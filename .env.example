# Copiez ce fichier en .env pour le développement local, ou définissez ces
# variables directement dans les réglages de votre plateforme d'hébergement
# (Render, autre) en production. Ne JAMAIS committer un .env réel dans Git.

# --- Sécurité ---
DJANGO_SECRET_KEY=change-moi-avec-une-cle-longue-et-aleatoire
DEBUG=False
ALLOWED_HOSTS=votre-domaine.example.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.example.com

# --- Base de données ---
# Vide -> SQLite (développement uniquement).
# Renseignée -> PostgreSQL (production), format :
#   postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE
DATABASE_URL=
DATABASE_SSL_REQUIRE=True
# Uniquement pour docker-compose (développement) : mot de passe de la base, sans @ : / #.
# Choisissez-en un long et aléatoire ; ne réutilisez jamais un mot de passe de production.
POSTGRES_PASSWORD=

# --- Production distribuée (facultatif en développement) ---
REDIS_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Pages légales (mentions légales, conditions d'utilisation, politique de confidentialité) ---
# Identité de l'éditeur de la plateforme, affichée sur ces pages. Laissez vide ce que vous ne souhaitez pas publier.
# Indicatif du pays et longueur d'un numéro local, pour les liens WhatsApp et SMS (Mali : 223 et 8 chiffres).
INDICATIF_TELEPHONIQUE=223
LONGUEUR_NUMERO_LOCAL=8
EDITEUR_NOM=
EDITEUR_STATUT=
EDITEUR_ADRESSE=
EDITEUR_EMAIL=
EDITEUR_TELEPHONE=
EDITEUR_IMMATRICULATION=
DIRECTEUR_PUBLICATION=
# Tant que les textes n'ont pas été relus par un juriste, laissez False : un bandeau « version provisoire » s'affiche.
PAGES_LEGALES_VALIDEES=False
# Imprimé en bas des factures d'abonnement des écoles (ex. « Orange Money : 70 00 00 00 - ou virement : ... »).
ABONNEMENT_INSTRUCTIONS_PAIEMENT=

# --- Stockage objet S3 / Cloudflare R2 (obligatoire si médias persistants) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Sans AWS_S3_CUSTOM_DOMAIN les liens sont TOUJOURS signés (une valeur False est ignorée : un lien non signé
# répondrait « Missing signature » et les logos seraient cassés). N'a d'effet qu'avec un domaine public.
AWS_QUERYSTRING_AUTH=True
# Durée de validité (secondes) des liens signés vers les fichiers : 3600 = 1 heure.
AWS_QUERYSTRING_EXPIRE=3600
# LAISSER VIDE (bucket privé, liens signés). Ne le renseignez que pour un bucket PUBLIC, ce qui rend tout
# fichier lisible par quiconque connaît son adresse.
AWS_S3_CUSTOM_DOMAIN=

# --- Email (vérification à l'inscription, annonces) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_ASYNC=False

# --- Assistant (mode génératif optionnel) ---
# Laisser vide -> l'Assistant reste en mode recherche simple (sans IA
# générative), conformément au comportement par défaut du cahier des charges.
GROQ_API_KEY=
ASSISTANT_MODELE_IA=openai/gpt-oss-120b

# --- Entretien de la base ---
# Les messages de la messagerie et des fils d'équipe sont effacés après ce nombre de jours (0 = jamais effacés).
DUREE_CONSERVATION_MESSAGES_JOURS=30
# True : l'entretien (messages anciens, sessions expirées) se lance tout seul, au plus une fois par jour.
ENTRETIEN_AUTOMATIQUE=True
